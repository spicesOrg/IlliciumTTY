<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="IlliciumTTY.Controls.ConnectionEditorPage"
             x:CompileBindings="False">
    <Border Background="#8A111827">
        <Border HorizontalAlignment="Right"
                Width="430"
                Margin="10,8,12,8"
                Background="#F8F9FC"
                BorderBrush="#DDE2ED"
                BorderThickness="1"
                CornerRadius="8"
                BoxShadow="0 16 36 0 #2A000000"
                Padding="20">
            <ScrollViewer>
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding EditorTitle}"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="#252B39" />

                    <TextBlock Text="名称" />
                    <TextBox Text="{Binding EditorName, Mode=TwoWay}" />

                    <TextBlock Text="所属区域" />
                    <ComboBox ItemsSource="{Binding GroupOptions}"
                              SelectedItem="{Binding EditorGroupOption, Mode=TwoWay}"
                              HorizontalAlignment="Stretch" />

                    <TextBlock Text="父文件夹" />
                    <ComboBox ItemsSource="{Binding FolderOptions}"
                              SelectedItem="{Binding EditorParentFolder, Mode=TwoWay}"
                              HorizontalAlignment="Stretch" />

                    <StackPanel IsVisible="{Binding IsEditorForLink}"
                                Spacing="12">
                        <TextBlock Text="主机地址" />
                        <TextBox Text="{Binding EditorHost, Mode=TwoWay}"
                                 PlaceholderText="example.com" />

                        <TextBlock Text="端口" />
                        <TextBox Text="{Binding EditorPortText, Mode=TwoWay}"
                                 PlaceholderText="22" />

                        <TextBlock Text="用户名" />
                        <TextBox Text="{Binding EditorUsername, Mode=TwoWay}" />

                        <TextBlock Text="认证方式" />
                        <ComboBox ItemsSource="{Binding AuthOptions}"
                                  SelectedItem="{Binding EditorAuthOption, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch" />

                        <TextBlock Text="密码" />
                        <TextBox Text="{Binding EditorPassword, Mode=TwoWay}"
                                 PlaceholderText="留空保留已保存密码"
                                 PasswordChar="*" />

                        <TextBlock Text="私钥路径（OpenSSH / PuTTY .ppk）" />
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0"
                                     Text="{Binding EditorPrivateKeyPath, Mode=TwoWay}"
                                     PlaceholderText="C:\Users\name\.ssh\id_ed25519 或 C:\Keys\server.ppk" />
                            <Button Grid.Column="1"
                                    Classes="iconButton"
                                    ToolTip.Tip="选择私钥文件"
                                    Click="OnPrivateKeyBrowseClicked"
                                    Margin="8,0,0,0">
                                <PathIcon Data="{StaticResource IconFolder}" />
                            </Button>
                        </Grid>

                        <TextBlock Text="私钥 Passphrase" />
                        <TextBox Text="{Binding EditorPassphrase, Mode=TwoWay}"
                                 PlaceholderText="留空保留已保存 Passphrase"
                                 PasswordChar="*" />

                        <TextBlock Text="默认远程路径" />
                        <TextBox Text="{Binding EditorDefaultRemotePath, Mode=TwoWay}"
                                 PlaceholderText="/home/user" />
                    </StackPanel>

                    <Grid ColumnDefinitions="*,Auto,Auto"
                          Margin="0,10,0,0">
                        <Button Grid.Column="1"
                                Classes="iconButton"
                                ToolTip.Tip="取消"
                                Command="{Binding CancelEditorCommand}"
                                Margin="0,0,8,0">
                            <PathIcon Data="{StaticResource IconClose}" />
                        </Button>
                        <Button Grid.Column="2"
                                Classes="iconButton"
                                ToolTip.Tip="保存"
                                Command="{Binding SaveEditorCommand}">
                            <PathIcon Data="{StaticResource IconSave}" />
                        </Button>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Border>
</UserControl>